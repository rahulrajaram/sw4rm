FROM rust:1.79 as builder

WORKDIR /app/examples/reference-services/rust

# Copy Cargo files and sources
COPY examples/reference-services/rust/Cargo.toml ./Cargo.toml
COPY examples/reference-services/rust/Cargo.lock ./Cargo.lock
COPY examples/reference-services/rust/build.rs ./build.rs
COPY examples/reference-services/rust/src ./src

# Copy protos for build.rs to find
COPY protos /app/protos

# Build release binary
RUN cargo build --release --bin router-service

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/examples/reference-services/rust/target/release/router-service /usr/local/bin/router-service

EXPOSE 50051
CMD ["/usr/local/bin/router-service"]
