FROM python:3.11-slim

WORKDIR /app

# Copy SDK and install in editable mode (local build context includes repo root)
COPY sdks/py_sdk /app/sdks/py_sdk
RUN pip install --no-cache-dir -e /app/sdks/py_sdk

# Copy service files and install service requirements
COPY examples/reference-services/python/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy scheduler service implementation
COPY examples/reference-services/python/hive/scheduler_service.py ./scheduler_service.py

# Expose scheduler port
EXPOSE 50053

# Run the scheduler service
CMD ["python", "scheduler_service.py"]
