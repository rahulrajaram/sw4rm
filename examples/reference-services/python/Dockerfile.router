FROM python:3.11-slim

WORKDIR /app

# Copy SDK and install in editable mode (local build context includes repo root)
COPY sdks/py_sdk /app/sdks/py_sdk
RUN pip install --no-cache-dir -e /app/sdks/py_sdk

# Copy service files and install service requirements
COPY examples/reference-services/python/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy router service implementation
COPY examples/reference-services/python/router_service.py ./router_service.py

# Expose router port
EXPOSE 50051

# Run the router service
CMD ["python", "router_service.py"]
