# Dockerfile.router
#
# SW4RM Common Lisp Router Service
#
# Build:
#   docker build -f Dockerfile.router -t sw4rm-cl-router ../../..
#
# Run:
#   docker run -p 50051:50051 sw4rm-cl-router

FROM debian:bookworm-slim

# Install SBCL and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    sbcl \
    curl \
    ca-certificates \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /app

# Install Quicklisp
RUN curl -O https://beta.quicklisp.org/quicklisp.lisp && \
    sbcl --non-interactive \
         --load quicklisp.lisp \
         --eval '(quicklisp-quickstart:install)' && \
    rm quicklisp.lisp

# Copy the SDK
COPY sdks/cl_sdk /app/sdks/cl_sdk

# Install SDK dependencies
RUN sbcl --non-interactive \
         --load ~/quicklisp/setup.lisp \
         --eval '(push #p"/app/sdks/cl_sdk/" asdf:*central-registry*)' \
         --eval '(ql:quickload :sw4rm-orchestrator :silent t)' \
         --eval '(format t "~%Dependencies installed~%")'

# Copy service file
COPY sdks/cl_sdk/reference-services/hive/router-service.lisp /app/router-service.lisp

# Expose port
EXPOSE 50051

# Run service
CMD ["sbcl", "--non-interactive", \
     "--load", "/root/quicklisp/setup.lisp", \
     "--load", "/app/router-service.lisp", \
     "--eval", "(router-service:main)"]
