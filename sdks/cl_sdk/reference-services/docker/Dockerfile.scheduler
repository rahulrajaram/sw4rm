# Dockerfile.scheduler
#
# SW4RM Common Lisp Scheduler Service
#
# Build:
#   docker build -f Dockerfile.scheduler -t sw4rm-cl-scheduler ../../..
#
# Run:
#   docker run -p 50053:50053 \
#     -e REGISTRY_HOST=localhost -e REGISTRY_PORT=50052 \
#     -e ROUTER_HOST=localhost -e ROUTER_PORT=50051 \
#     sw4rm-cl-scheduler

FROM debian:bookworm-slim

# Install SBCL and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    sbcl \
    curl \
    ca-certificates \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /app

# Install Quicklisp
RUN curl -O https://beta.quicklisp.org/quicklisp.lisp && \
    sbcl --non-interactive \
         --load quicklisp.lisp \
         --eval '(quicklisp-quickstart:install)' && \
    rm quicklisp.lisp

# Copy the SDK
COPY sdks/cl_sdk /app/sdks/cl_sdk

# Install SDK dependencies
RUN sbcl --non-interactive \
         --load ~/quicklisp/setup.lisp \
         --eval '(push #p"/app/sdks/cl_sdk/" asdf:*central-registry*)' \
         --eval '(ql:quickload :sw4rm-orchestrator :silent t)' \
         --eval '(format t "~%Dependencies installed~%")'

# Copy service file
COPY sdks/cl_sdk/reference-services/hive/scheduler-service.lisp /app/scheduler-service.lisp

# Expose port
EXPOSE 50053

# Environment defaults
ENV REGISTRY_HOST=registry
ENV REGISTRY_PORT=50052
ENV ROUTER_HOST=router
ENV ROUTER_PORT=50051

# Run service
CMD ["sbcl", "--non-interactive", \
     "--load", "/root/quicklisp/setup.lisp", \
     "--load", "/app/scheduler-service.lisp", \
     "--eval", "(scheduler-service:main)"]
