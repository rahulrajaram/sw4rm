{
  "name": "sw4rm-services-js",
  "version": "0.1.0",
  "description": "SW4RM Protocol Services - Registry and Router reference implementations using the JS SDK",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:registry": "tsx src/registry-service-proper.ts",
    "start:router": "tsx src/router-service-proper.ts",
    "start:scheduler": "tsx src/scheduler-service.ts",
    "start:multi-agent": "tsx src/sw4rm-multi-agent.ts",
    "start:all": "tsx src/start-services.ts",
    "start:coordination": "tsx src/coordination/server.ts",
    "dev": "npm run build && npm run start:all"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.15.7",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.13",
    "@sw4rm/js-sdk": "file:..",
    "commander": "^12.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}