#!/usr/bin/env bash
set -euo pipefail

red() { printf "\033[31m%s\033[0m\n" "$*"; }
green() { printf "\033[32m%s\033[0m\n" "$*"; }

require_file() {
  [[ -f "$1" ]] || { red "Missing required file: $1"; exit 1; }
}

semver_re='^[0-9]+\.[0-9]+\.[0-9]+$'

spec_ver() {
  sed -n -E 's/^Version:[[:space:]]*([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' documentation/protocol/spec.md | head -n1
}

py_ver() {
  # Extract version under [project]
  awk 'BEGIN{p=0} /^\[project\]/{p=1;next} /^\[/{p=0} p==1 && $1=="version"{gsub(/"/,"",$3); print $3; exit}' pyproject.toml
}

js_ver() {
  sed -n -E 's/[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' sdks/js_sdk/package.json | head -n1
}

rs_ver() {
  awk 'BEGIN{p=0} /^\[package\]/{p=1;next} /^\[/{p=0} p==1 && $1=="version"{gsub(/"/,"",$3); print $3; exit}' sdks/rust_sdk/Cargo.toml
}

require_file documentation/protocol/spec.md
require_file pyproject.toml
require_file sdks/js_sdk/package.json
require_file sdks/rust_sdk/Cargo.toml

SPEC=$(spec_ver)
PY=$(py_ver)
JS=$(js_ver)
RS=$(rs_ver)

[[ $SPEC =~ $semver_re ]] || { red "Spec version not SemVer: '$SPEC'"; exit 1; }
[[ $PY =~ $semver_re ]]   || { red "Python version not SemVer: '$PY'"; exit 1; }
[[ $JS =~ $semver_re ]]   || { red "JS version not SemVer: '$JS'"; exit 1; }
[[ $RS =~ $semver_re ]]   || { red "Rust version not SemVer: '$RS'"; exit 1; }

if [[ "$PY" != "$SPEC" || "$JS" != "$SPEC" || "$RS" != "$SPEC" ]]; then
  red "SDK versions must equal spec version. spec=$SPEC py=$PY js=$JS rs=$RS"
  red "Run: python scripts/bump_version.py $SPEC"
  exit 1
fi

# Optional stricter checks: if certain paths changed, ensure bump vs HEAD
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  CHANGED=$(git diff --cached --name-only)
  NORMATIVE_PROTOCOL_CHANGED=$(echo "$CHANGED" | grep -E '^(documentation/protocol/|protos/)' | grep -Ev '^(documentation/protocol/sdk_extensions\.md|documentation/protocol/extensions/index\.md)$' || true)
  VERSIONED_PY_CHANGED=$(echo "$CHANGED" | grep -E '^sdks/py_sdk/sw4rm/' || true)
  VERSIONED_JS_CHANGED=$(echo "$CHANGED" | grep -E '^sdks/js_sdk/(src/|protos/|package\.json$)' || true)
  JS_EXAMPLE_CHANGED=$(echo "$CHANGED" | grep -E '^sdks/js_sdk/examples/.*\.ts$' || true)
  VERSIONED_RS_CHANGED=$(echo "$CHANGED" | grep -E '^sdks/rust_sdk/(src/|protos/|Cargo\.toml$)' || true)
  RS_EXAMPLE_CHANGED=$(echo "$CHANGED" | grep -E '^sdks/rust_sdk/examples/.*\.rs$' || true)
  base_ver() { git show HEAD:$1 2>/dev/null | sed -n -E "$2" | head -n1; }
  BASE_SPEC=$(base_ver documentation/protocol/spec.md 's/^Version:[[:space:]]*([0-9]+\.[0-9]+\.[0-9]+).*/\1/p')
  BASE_PY=$(base_ver pyproject.toml '/^\[project\]/,/^\[/{s/^version[[:space:]]*=[[:space:]]*"([^"]+)"/\1/p}')
  BASE_JS=$(base_ver sdks/js_sdk/package.json 's/[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p')
  BASE_RS=$(git show HEAD:sdks/rust_sdk/Cargo.toml 2>/dev/null | awk 'BEGIN{p=0} /^\[package\]/{p=1;next} /^\[/{p=0} p==1 && $1=="version"{gsub(/"/,"",$3); print $3; exit}')

  greater() { python - "$1" "$2" <<'PY'
import sys
def norm(v):
    return tuple(map(int, v.split('.'))) if v else None
v1, v2 = map(norm, sys.argv[1:3])
sys.exit(0 if v2 is None or (v1 and v2 and v1>v2) else 1)
PY
  }

  if [[ -n "$NORMATIVE_PROTOCOL_CHANGED" ]]; then
    if ! greater "$SPEC" "$BASE_SPEC"; then
      red "Spec changed but version not bumped (head=$SPEC base=${BASE_SPEC:-unset})."; exit 1
    fi
  fi
  if [[ -n "$VERSIONED_PY_CHANGED" ]]; then
    if ! greater "$PY" "$BASE_PY"; then red "Python SDK changed but version not bumped (head=$PY base=${BASE_PY:-unset})."; exit 1; fi
  fi
  if [[ -n "$VERSIONED_JS_CHANGED" ]]; then
    if ! greater "$JS" "$BASE_JS"; then red "JS SDK changed but version not bumped (head=$JS base=${BASE_JS:-unset})."; exit 1; fi
  fi
  if [[ -n "$VERSIONED_RS_CHANGED" ]]; then
    if ! greater "$RS" "$BASE_RS"; then red "Rust SDK changed but version not bumped (head=$RS base=${BASE_RS:-unset})."; exit 1; fi
  fi
fi

green "pre-commit: version checks passed"

# If docs changed, run a strict MkDocs build for internal link/anchor validation
if echo "$CHANGED" | grep -E '^documentation/|^mkdocs.yml' >/dev/null 2>&1; then
  if command -v venv/bin/mkdocs >/dev/null 2>&1; then
    green "pre-commit: running mkdocs build --strict (docs changed)"
    if ! venv/bin/mkdocs build --strict >/dev/null; then
      red "MkDocs strict build failed. Fix docs links/anchors or disable temporarily."
      exit 1
    fi
  fi
fi

# Linting checks for critical errors
if echo "$CHANGED" | grep -E '^sdks/py_sdk/.*\.py$' >/dev/null 2>&1; then
  green "pre-commit: running Python linter (critical errors only)"
  if command -v python3 >/dev/null 2>&1; then
    # Check for critical errors: syntax errors, undefined names
    if ! python3 -m flake8 sdks/py_sdk/sw4rm/ --select=E9,F63,F7,F82,F821 --count 2>/dev/null; then
      red "Python linting failed with critical errors. Fix undefined names and syntax errors."
      exit 1
    fi
  fi
fi

if [[ -n "$VERSIONED_JS_CHANGED" ]]; then
  green "pre-commit: running JavaScript/TypeScript linter"
  if command -v npx >/dev/null 2>&1; then
    pushd sdks/js_sdk >/dev/null 2>&1
    if ! npx eslint src/ --max-warnings 0 --quiet 2>/dev/null; then
      red "JavaScript linting failed. Run: cd sdks/js_sdk && npx eslint src/ --fix"
      popd >/dev/null 2>&1
      exit 1
    fi
    popd >/dev/null 2>&1
  fi
fi

if [[ -n "$JS_EXAMPLE_CHANGED" ]]; then
  green "pre-commit: typechecking JavaScript/TypeScript examples"
  if command -v npx >/dev/null 2>&1; then
    pushd sdks/js_sdk >/dev/null 2>&1
    EXAMPLE_FILES=$(echo "$JS_EXAMPLE_CHANGED" | sed 's#^sdks/js_sdk/##')
    if ! npx tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022 --types node $EXAMPLE_FILES >/dev/null 2>&1; then
      red "JavaScript example typecheck failed. Run: cd sdks/js_sdk && npx tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022 --types node examples/<file>.ts"
      popd >/dev/null 2>&1
      exit 1
    fi
    popd >/dev/null 2>&1
  fi
fi

if [[ -n "$VERSIONED_RS_CHANGED" ]]; then
  green "pre-commit: running Rust linter"
  pushd sdks/rust_sdk >/dev/null 2>&1
  if command -v cargo >/dev/null 2>&1; then
    if ! cargo clippy --quiet -- -D warnings 2>/dev/null; then
      red "Rust linting failed. Run: cd sdks/rust_sdk && cargo clippy --fix"
      popd >/dev/null 2>&1
      exit 1
    fi
  fi
  popd >/dev/null 2>&1
fi

if [[ -n "$RS_EXAMPLE_CHANGED" ]]; then
  green "pre-commit: checking Rust examples"
  pushd sdks/rust_sdk >/dev/null 2>&1
  if command -v cargo >/dev/null 2>&1; then
    if ! cargo check --examples >/dev/null 2>&1; then
      red "Rust example check failed. Run: cd sdks/rust_sdk && cargo check --examples"
      popd >/dev/null 2>&1
      exit 1
    fi
  fi
  popd >/dev/null 2>&1
fi
